#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG="/usr/bin/gost"
NAME="gost"

append_listen() {
	procd_append_param command -L "$1"
}

append_forward() {
	procd_append_param command -F "$1"
}

append_arg() {
	procd_append_param command "$1"
}

start_instance() {
	local section="$1"
	local enabled config api metrics debug trace user group respawn
	local respawn_threshold respawn_timeout respawn_retry

	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get config "$section" config
	config_get api "$section" api
	config_get metrics "$section" metrics
	config_get_bool debug "$section" debug 0
	config_get_bool trace "$section" trace 0
	config_get user "$section" user root
	config_get group "$section" group root
	config_get_bool respawn "$section" respawn 1
	config_get respawn_threshold "$section" respawn_threshold 3600
	config_get respawn_timeout "$section" respawn_timeout 5
	config_get respawn_retry "$section" respawn_retry 5

	procd_open_instance "$section"
	procd_set_param command "$PROG"
	[ -z "$config" ] || procd_append_param command -C "$config"
	config_list_foreach "$section" listen append_listen
	config_list_foreach "$section" forward append_forward
	[ -z "$api" ] || procd_append_param command -api "$api"
	[ -z "$metrics" ] || procd_append_param command -metrics "$metrics"
	[ "$debug" -eq 0 ] || procd_append_param command -D
	[ "$trace" -eq 0 ] || procd_append_param command -DD
	config_list_foreach "$section" arg append_arg

	[ -z "$config" ] || procd_set_param file "$config"
	procd_set_param user "$user"
	procd_set_param group "$group"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	[ "$respawn" -eq 0 ] || \
		procd_set_param respawn "$respawn_threshold" "$respawn_timeout" "$respawn_retry"
	procd_close_instance
}

start_service() {
	config_load "$NAME"
	config_foreach start_instance instance
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}

reload_service() {
	stop
	start
}
